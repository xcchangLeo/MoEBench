\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Overview of the \textsc  {BenchScout}\xspace  architecture. (1)\nonbreakingspace \textbf  {Host OS:} collector aggregates static and dynamic metrics into $\mathbf  {x}$. (2)\nonbreakingspace \textbf  {Router:} scores experts and selects Top-$K$. (3)\nonbreakingspace \textbf  {Probing:} category micro-workloads (or real subtests) run under a fixed budget and emit $\mathbf  {p}$. (4)\nonbreakingspace \textbf  {Reconstructor:} multi-output regressor predicts $\hat  {\mathbf  {y}}$ and $\hat  {Y}$.}}{2}{figure.caption.7}\protected@file@percent }
\newlabel{fig:mob}{{2}{2}{Overview of the \ourmethod architecture. (1)~\textbf {Host OS:} collector aggregates static and dynamic metrics into $\mathbf {x}$. (2)~\textbf {Router:} scores experts and selects Top-$K$. (3)~\textbf {Probing:} category micro-workloads (or real subtests) run under a fixed budget and emit $\mathbf {p}$. (4)~\textbf {Reconstructor:} multi-output regressor predicts $\hat {\mathbf {y}}$ and $\hat {Y}$}{figure.caption.7}{}}
