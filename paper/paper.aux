\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Overview of the \textsc  {BenchScout}\xspace  architecture. (1) \textbf  {Host OS:} Collector aggregates static and dynamic metrics into system context. (2) \textbf  {Router:} Router evaluates this context to select sparse benchmark subsets. (3) \textbf  {Probing:} Selected cases undergo time-bounded probing yielding partial telemetry. (4) \textbf  {Reconstructor:} Regressor predicts full profile from the encoded sparse telemetry.}}{3}{figure.caption.9}\protected@file@percent }
\newlabel{fig:mob}{{2}{3}{Overview of the \ourmethod architecture. (1) \textbf {Host OS:} Collector aggregates static and dynamic metrics into system context. (2) \textbf {Router:} Router evaluates this context to select sparse benchmark subsets. (3) \textbf {Probing:} Selected cases undergo time-bounded probing yielding partial telemetry. (4) \textbf {Reconstructor:} Regressor predicts full profile from the encoded sparse telemetry}{figure.caption.9}{}}
