\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Overview of the \textsc  {BenchScout}\xspace  architecture. (1)\nonbreakingspace \textbf  {Host OS:} collector aggregates static and dynamic metrics into $\mathbf  {x}$. (2)\nonbreakingspace \textbf  {Router:} scores experts and selects Top-$K$. (3)\nonbreakingspace \textbf  {Probing:} category micro-workloads (or real subtests) run under a fixed budget and emit $\mathbf  {p}$. (4)\nonbreakingspace \textbf  {Reconstructor:} multi-output regressor predicts $\hat  {\mathbf  {y}}$ and $\hat  {Y}$; an optional uncertainty head estimates per-target $\sigma $ (Section\nonbreakingspace \ref {subsec:uncertainty-estimator}) but is \emph  {not} used in the default single-pass pipeline.}}{4}{figure.caption.12}\protected@file@percent }
\newlabel{fig:mob}{{3}{4}{Overview of the \ourmethod architecture. (1)~\textbf {Host OS:} collector aggregates static and dynamic metrics into $\mathbf {x}$. (2)~\textbf {Router:} scores experts and selects Top-$K$. (3)~\textbf {Probing:} category micro-workloads (or real subtests) run under a fixed budget and emit $\mathbf {p}$. (4)~\textbf {Reconstructor:} multi-output regressor predicts $\hat {\mathbf {y}}$ and $\hat {Y}$; an optional uncertainty head estimates per-target $\sigma $ (Section~\ref {subsec:uncertainty-estimator}) but is \emph {not} used in the default single-pass pipeline}{figure.caption.12}{}}
